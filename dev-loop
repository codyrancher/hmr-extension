#!/usr/bin/env node
// Headless control for the dev loop: on | off | status.
//
// MetaExtension owns installing the dev server; this only flips Rancher between it and the
// bundled UI. It exists because the UI cannot be trusted to turn itself off: once
// ui-offline-preferred is Remote, Rancher serves whatever the dev server pod hands it, and
// if that pod is unhealthy there is no UI at all - including MetaExtension's own page.
// This talks straight to the Rancher API, so it works when nothing else does.
import fs from 'fs';
import https from 'https';

const env = Object.fromEntries(
  fs.readFileSync('/workspace/.env', 'utf8')
    .split('\n')
    .filter((l) => l.includes('=') && !l.trim().startsWith('#'))
    .map((l) => {
      const i = l.indexOf('=');

      return [l.slice(0, i).trim(), l.slice(i + 1).trim()];
    })
);

const HOST = env.RANCHER_HOST_NAME || 'hmr-extension-rancher';
const NS = 'dev-extension-system';
const DEV_SERVER = 'devserver';
const DEV_PORT = 8005;
const STATE_CM = 'dev-loop-state';
const DEFAULT_INDEX = 'https://releases.rancher.com/dashboard/latest/index.html';

const CORE = `/k8s/clusters/local/api/v1/namespaces/${ NS }`;
const APPS = `/k8s/clusters/local/apis/apps/v1/namespaces/${ NS }`;

const agent = new https.Agent({ rejectUnauthorized: false });

function req(pathname, { method = 'GET', body, token } = {}) {
  return new Promise((resolve, reject) => {
    const data = body ? JSON.stringify(body) : null;
    const headers = { 'Content-Type': 'application/json' };

    if (token) {
      headers.Authorization = `Bearer ${ token }`;
    }
    if (data) {
      headers['Content-Length'] = Buffer.byteLength(data);
    }

    const r = https.request({
      host: HOST, path: pathname, method, headers, agent
    }, (res) => {
      let out = '';

      res.on('data', (c) => (out += c));
      res.on('end', () => {
        let parsed = out;

        try {
          parsed = JSON.parse(out);
        } catch {}

        if (res.statusCode >= 400) {
          return reject(Object.assign(new Error(`${ res.statusCode } ${ pathname }`), { status: res.statusCode, body: parsed }));
        }
        resolve(parsed);
      });
    });

    r.on('error', reject);
    if (data) {
      r.write(data);
    }
    r.end();
  });
}

async function login() {
  const res = await req('/v3-public/localProviders/local?action=login', {
    method: 'POST',
    body:   { username: env.RANCHER_ADMIN_USER, password: env.RANCHER_ADMIN_PASS }
  });

  return res.token;
}

const getSetting = (token, name) => req(`/v3/settings/${ name }`, { token }).then((s) => s.value ?? s.default ?? '');
const setSetting = (token, name, value) => req(`/v3/settings/${ name }`, {
  method: 'PUT', token, body: { name, value }
});

async function getStateData(token) {
  try {
    const cm = await req(`${ CORE }/configmaps/${ STATE_CM }`, { token });

    return cm.data || {};
  } catch {
    return {};
  }
}

/** Write the ConfigMap's data verbatim - callers merge first, this never does. */
async function putStateData(token, data) {
  const body = {
    apiVersion: 'v1',
    kind:       'ConfigMap',
    metadata:   { name: STATE_CM, namespace: NS },
    data
  };

  try {
    await req(`${ CORE }/configmaps`, { method: 'POST', token, body });
  } catch (e) {
    if (e.status !== 409) {
      throw e;
    }
    const existing = await req(`${ CORE }/configmaps/${ STATE_CM }`, { token });

    body.metadata.resourceVersion = existing.metadata.resourceVersion;
    await req(`${ CORE }/configmaps/${ STATE_CM }`, { method: 'PUT', token, body });
  }
}

/**
 * Record what the user asked for. Read-modify-write: `previous` (the settings `off`
 * restores) lives in the same ConfigMap, and writing `desired` alone would erase it.
 */
async function setDesired(token, value) {
  const data = await getStateData(token);

  await putStateData(token, { ...data, desired: value });
}

async function serverState(token) {
  let ready = false;
  let clusterIp = '';
  let installed = false;

  try {
    const d = await req(`${ APPS }/deployments/${ DEV_SERVER }`, { token });

    installed = true;
    ready = (d.status?.readyReplicas || 0) > 0;
  } catch {}

  try {
    const s = await req(`${ CORE }/services/${ DEV_SERVER }`, { token });

    clusterIp = s.spec?.clusterIP || '';
  } catch {}

  return { installed, ready, clusterIp };
}

async function status(token) {
  const index = await getSetting(token, 'ui-dashboard-index');
  const offline = await getSetting(token, 'ui-offline-preferred');
  const s = await serverState(token);
  const data = await getStateData(token);
  const on = offline === 'Remote' && !index.includes('releases.rancher.com');
  const desired = data.desired || 'disabled';

  console.log(`dev loop            : ${ on ? 'ON' : 'OFF' }`);
  console.log(`desired             : ${ desired }`);
  if (desired === 'enabled' && !on) {
    console.log('                      (activation pending - open the Dev Loop page, or re-run ./dev-loop on, once the pod is ready)');
  }
  console.log(`dev server pod      : ${ s.installed ? (s.ready ? 'ready' : 'starting') : 'not installed' }`);
  console.log(`served from         : ${ s.clusterIp ? `${ s.clusterIp }:${ DEV_PORT } (in-cluster)` : '-' }`);
  console.log(`ui-dashboard-index  : ${ index }`);
  console.log(`ui-offline-preferred: ${ offline }`);
}

const [, , cmd] = process.argv;
const token = await login();

if (cmd === 'on') {
  const s = await serverState(token);

  if (!s.installed) {
    console.error('dev server is not installed - enable it once from MetaExtension (Dev Loop page)');
    process.exit(1);
  }

  // Record intent before the readiness guard below, not after: this way a not-ready pod
  // still leaves something for a later ./dev-loop on, or the Dev Loop page's periodic
  // reconcile, to finish - the same durability the UI's Enable button relies on.
  await setDesired(token, 'enabled');

  // Refusing to switch over before the pod answers is the whole safety story: a Remote
  // index pointed at a dead server leaves no UI to fix it with.
  if (!s.ready) {
    console.error('dev server pod is not ready yet - refusing to switch Rancher over to it');
    console.error('desired state recorded as enabled - it will activate once the pod is ready');
    process.exit(1);
  }

  const previous = {
    'ui-dashboard-index':   await getSetting(token, 'ui-dashboard-index'),
    'ui-offline-preferred': await getSetting(token, 'ui-offline-preferred')
  };

  if (previous['ui-offline-preferred'] !== 'Remote') {
    // Merge, not replace: `desired` was just written into this same ConfigMap above.
    const data = await getStateData(token);

    await putStateData(token, { ...data, previous: JSON.stringify(previous) });
  }

  await setSetting(token, 'ui-dashboard-index', `http://${ s.clusterIp }:${ DEV_PORT }/index.html`);
  await setSetting(token, 'ui-offline-preferred', 'Remote');
  console.log('dev loop ON');
  await status(token);
} else if (cmd === 'off') {
  const data = await getStateData(token);
  const previous = JSON.parse(data.previous || '{}');

  await setSetting(token, 'ui-offline-preferred', previous['ui-offline-preferred'] || 'dynamic');
  await setSetting(token, 'ui-dashboard-index', previous['ui-dashboard-index'] || DEFAULT_INDEX);
  await putStateData(token, { ...data, desired: 'disabled' });
  console.log('dev loop OFF - Rancher is serving its own bundled UI again');
  await status(token);
} else if (cmd === 'status') {
  await status(token);
} else {
  console.log('usage: ./dev-loop on | off | status');
  process.exit(1);
}
